# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/asyncraft
# For local dev, use SQLite:
# DATABASE_URL=sqlite:///./asyncraft.db

# OpenAI API (optional - uses mock by default for demo)
OPENAI_API_KEY=sk-mock-key-for-demo

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Active skin (ops_dispatch or deal_flow)
ACTIVE_SKIN=ops_dispatch
